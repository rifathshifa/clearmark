# ==========================================
# ClearMark - Environment Configuration Template
# ==========================================

# PostgreSQL Connection String (e.g. Neon, Supabase, Render Postgres)
# Replace with your actual connection string in Render Dashboard or local .env
DATABASE_URL=postgresql://username:password@ep-example.us-east-2.aws.neon.tech/neondb?sslmode=require

# Server Port (Render sets this dynamically via $PORT)
PORT=5000

# Optional: Set to true if you want the build process to download the Big-LaMa ONNX model (190MB)
DOWNLOAD_MODEL=false

